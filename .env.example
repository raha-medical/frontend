# عنوان الـ API. الافتراضي /api/v1 على نفس أصل الواجهة، وNext يمرّره إلى API_PROXY_TARGET (بلا CORS)
NEXT_PUBLIC_API_URL=/api/v1
# عنوان الباك اند الفعلي (Docker أو dotnet run)
API_PROXY_TARGET=http://localhost:8088

# وكيل العتاد (الطابعة والدرج): simulate = طباعة من المتصفح بلا درج | agent = الوكيل الحقيقي
NEXT_PUBLIC_AGENT_MODE=simulate
NEXT_PUBLIC_AGENT_URL=https://localhost:9443

# رمز جهاز الاستقبال المسجل في الباك اند (device_code)، يلزم للمزامنة وكتل الإيصالات
NEXT_PUBLIC_DEVICE_CODE=
