# Vercel Project Settings > Environment Variables. Build-time values: redeploy after changes.
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=https://YOUR-BACKEND.up.railway.app
NEXT_PUBLIC_HUB_URL=https://YOUR-BACKEND.up.railway.app/hubs/live
NEXT_PUBLIC_PATIENT_APP_URL=https://YOUR-FRONTEND.vercel.app/patient
NEXT_PUBLIC_AGENT_MODE=simulate
# No JWT/database/storage secrets belong in NEXT_PUBLIC_* variables.
